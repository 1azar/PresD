# Use a long value containing only ASCII letters and digits (it is embedded in a database URL).
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
REDIS_PASSWORD=replace_with_a_different_long_random_password

# JSON object: login -> password. Keep the whole value on one line.
WEBAPP_ALLOWED_CLIENTS_JSON={"admin":"replace_with_a_long_random_ui_password"}

# The VM's dedicated public IPv4 address and an email for Let's Encrypt notices.
PUBLIC_IP=203.0.113.10
TLS_EMAIL=admin@example.com

# Any OpenAI-compatible endpoint. This example addresses a model server running
# on the Docker host; replace the model ID with one installed on that server.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=replace_with_model_id
LLM_API_KEY=not-needed
LLM_PROJECT=
LLM_API_MODE=chat_completions
LLM_STRUCTURED_OUTPUT=native
LLM_TIMEOUT=90

# Optional visual-model overrides. Empty values inherit their LLM_* counterpart.
VLM_BASE_URL=
VLM_MODEL=
VLM_API_KEY=
VLM_PROJECT=
VLM_API_MODE=
VLM_TIMEOUT=
# Strict planning keeps at most four GPT requests in flight.
WEBAPP_PLANNER_MAX_WORKERS=4
WEBAPP_PLANNER_STRICT_BUDGET=300
WEBAPP_PLANNER_FAST_BUDGET=135
WEBAPP_PLANNER_OUTLINE_WAVE_BUDGET=105
WEBAPP_PLANNER_SLIDE_WAVE_BUDGET=105
WEBAPP_PLANNER_CRITIQUE_WAVE_BUDGET=75
WEBAPP_GENERATION_JOB_TIMEOUT=420
